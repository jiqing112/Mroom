# HTTP listen address
MROME_ADDR=:4533

# Where audio files live (mounted volume)
MROME_MUSIC_DIR=./data/music

# SQLite database, covers, upload staging and trash live here
MROME_DATA_DIR=./data

# Optional overrides
# MROME_DB=./data/mrome.db
# MROME_COVERS_DIR=./data/covers
# MROME_UPLOADS_DIR=./data/uploads
# MROME_WEB_DIR=./web/dist

# Bootstrap administrator (created when no administrator exists).
# Leave both empty to enable guest mode: the web UI opens straight to the
# library with a shared non-admin guest account.
MROME_ADMIN_USER=admin
MROME_ADMIN_PASSWORD=admin

# Upload guard rails
MROME_MAX_UPLOAD_MB=512

# Scan the music folder on boot
MROME_SCAN_ON_START=true
